# Copy to .env and fill values to enable MySQL
# Set USE_MYSQL=true to enable MySQL mode. If not set, server uses data.json
USE_MYSQL=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=reader_admin

# Optional: server port
PORT=4000

# SePay. SEPAY_LOCAL=true chỉ chạy khi NODE_ENV không phải production.
# Webhook trên máy: POST /sepay/webhook với header Authorization: Apikey <SEPAY_API_KEY>
# App có nút xác nhận trên QR để cộng xu mà không chuyển khoản thật.
SEPAY_LOCAL=true
SEPAY_API_KEY=local-sepay
SEPAY_API_TOKEN=your_sepay_api_token
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NO=123406072004
SEPAY_ACCOUNT_NAME=Hoang Van Huy

# Wallet pricing
COIN_VND=100
VIP_COST_COINS=500
AUTHOR_COST_BASE=800
AUTHOR_COST_VIP=300
MIN_VIP_DAYS_FOR_DISCOUNT=15

# Bank transfer lookup used by POST /wallet/verify-payment when SePay token is unset
BANK_API_URL=https://bank.dinhmanhhung.net/check-payment

# Required in production. Also required for POST /payments/webhook.
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# Chat agent (recommend + chapter recap).
# api.x.ai: first real key among XAI_API_KEY, GROK_API_KEY, AI_API_KEY.
# Any other base (for example https://api.xah.io/v1) uses AI_API_KEY only.
# YOUR_API_KEY, changeme, and replace_me are ignored.
XAI_API_KEY=
GROK_API_KEY=
AI_API_KEY=
AI_API_BASE=https://api.x.ai/v1
AI_MODEL=grok-4.5
# Used once when the primary model returns HTTP 404, 408, 429, or 5xx.
AI_FALLBACK_MODEL=
AI_CHAT_MODEL=
AI_RECAP_MODEL=
AI_MODERATION_MODEL=
AI_PLAGIARISM_MODEL=
# Per-call deadline; background moderation no longer falls back after only 8 seconds.
AI_TIMEOUT_MS=25000
AI_MODERATION_TIMEOUT_MS=25000
AI_PLAGIARISM_TIMEOUT_MS=25000
AI_RECAP_MAX_CHARS=60000
# Counts actual model calls, including tool rounds; shared MySQL counters.
AI_DAILY_CALL_LIMIT=1000
AI_USER_DAILY_CALL_LIMIT=100
# Recommendation cost controls; cached selections always recheck story visibility.
AI_RECOMMEND_MAX_ROUNDS=3
AI_RECOMMEND_MAX_TOKENS=240
AI_RECOMMEND_CACHE_TTL_MS=300000
AI_RECOMMEND_CACHE_MAX_ENTRIES=500
# Short fallback cache/provider cooldown after timeout, network failure, HTTP 429/5xx.
AI_RECOMMEND_FAILURE_TTL_MS=15000
AI_RECOMMEND_MAX_INFLIGHT=50
AI_WORKER_ENABLED=true
# Set only after verifying the gateway's cost unit. Never assume USD.
AI_PROVIDER_COST_UNIT=unknown
# Langfuse project credentials. Use the host for your project's region.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
# Must match the environment used by the OTLP exporter and dashboard reads.
LANGFUSE_ENVIRONMENT=development
# Empty means do not trust forwarded IP headers. Example for a local reverse proxy:
TRUST_PROXY=
# TRUST_PROXY=loopback
# AI_API_BASE=https://api.xah.io/v1
# AI_MODEL=openai/gpt-6-luna
# Firebase project used to verify Google/Facebook ID tokens on the server.
FIREBASE_PROJECT_ID=newsai-793dc
# Firebase Admin credential for FCM delivery: set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path,
# or set FIREBASE_SERVICE_ACCOUNT_JSON to the service-account JSON string in hosted environments.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
